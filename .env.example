# Copy to .env (which is gitignored) and fill in. Everything is optional:
# without ANTHROPIC_API_KEY the system runs in offline mode.

# Claude API key: enables LLM routing, LLM tool selection, live web research
# and model-written summaries. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model and effort (defaults shown)
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Force offline mode even when a key is set (1 = yes)
DISABLE_LLM=0

# Size of the LSA embeddings used by the RAG index
EMBEDDING_DIMENSIONS=256
